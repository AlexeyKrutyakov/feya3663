# Local development environment (copy to .env and adjust).
# Real secrets (MIS credentials, DB passwords) never go in git.

# --- docker-compose.yml (postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=feya
# Host ports (change if another local postgres/redis already uses them)
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- apps/api ---
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feya
REDIS_URL=redis://localhost:6379

# --- MIS (Arnica Dental / SQNS) — fill with real values in local .env ---
MIS_API_URL=https://crmexchange.1denta.ru
MIS_LOGIN=
MIS_PASSWORD=
MIS_WEBHOOK_SECRET=

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
